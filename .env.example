# Property Helper — Environment Variable Contract
#
# This file is the canonical source of truth for all env vars used by the
# backend and frontend. Copy the relevant section into:
#   - backend/.env         (backend section, gitignored)
#   - frontend/.env.local  (frontend section, gitignored)
#
# Never commit a real secret. All values below are placeholders.

# === Backend (backend/.env) ===
SUPABASE_DB_URL=postgresql://postgres.<your-supabase-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<your-supabase-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
REDIS_URL=redis://localhost:6379
MAX_ITERS=10
TOKEN_BUDGET=50000
MAX_TOOL_RESULT_BYTES=8192
SCRAPER_MAX_LISTINGS=10

# === Frontend (frontend/.env.local) ===
NEXT_PUBLIC_SUPABASE_URL=https://<your-supabase-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
NEXT_PUBLIC_API_URL=http://localhost:8000
