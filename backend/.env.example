# Backend environment contract (D-02 + Phase 4 D-09).
#
# Copy to backend/.env and fill in real values. Never commit secrets.
# The canonical full contract lives at ../.env.example; this file mirrors
# the backend section and adds Phase 4's Anthropic key requirement.

SUPABASE_DB_URL=postgresql://postgres.<your-supabase-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<your-supabase-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
REDIS_URL=redis://localhost:6379
MAX_ITERS=10
TOKEN_BUDGET=50000
MAX_TOOL_RESULT_BYTES=8192
SCRAPER_MAX_LISTINGS=10
ANTHROPIC_API_KEY=<your-anthropic-api-key>
