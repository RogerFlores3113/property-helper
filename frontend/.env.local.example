# Supabase project URL (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public API key (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin used for magic-link emailRedirectTo. Local dev = http://localhost:3000; in Vercel set to production URL per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
